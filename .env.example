
# Local PostgreSQL
POSTGRES_PASSWORD=stayhub_local

# Keycloak local admin account
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Use the client secrets matching your imported realm
KEYCLOAK_AUTH_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Optional: only needed for authenticated SMTP
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Real object-storage credentials for actual image uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional: required for payment operations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional MediatR license key
MEDIATR_LICENSE_KEY=
