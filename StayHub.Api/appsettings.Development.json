{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=StayHub;Username=postgres;Password=postgres;",
    "Cache": "localhost:6379"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FromAddress": "stayhub.teams@gmail.com",
    "FromName": "StayHub"
  },
  "Storage": {
    "Provider": 3,
    "ServiceUrl": "https://s3.eu-south-1.idrivee2.com",
    "Region": "eu-south-1",
    "BucketName": "stayhub-media",
    "AccessKey": "",
    "SecretKey": "",
    "PresignedUrlExpirationMinutes": 60
  },
  "Authentication": {
    "Audience": "account",
    "MetadataUrl": "http://localhost:18080/realms/StayHub/.well-known/openid-configuration",
    "Issuer": "http://localhost:18080/realms/StayHub",
    "RequireHttpsMetadata": false
  },
  "Keycloak": {
    "BaseUrl": "http://localhost:18080",
    "AdminUrl": "http://localhost:18080/admin/realms/StayHub/",
    "TokenUrl": "http://localhost:18080/realms/StayHub/protocol/openid-connect/token",
    "AdminClientId": "stayhub-admin-client",
    "AdminClientSecret": "",
    "AuthClientId": "stayhub-auth-client",
    "AuthClientSecret": "",
    "PasswordResetClientId": "stayhub-auth-client",
    "PasswordResetRedirectUri": "",
    "PasswordResetLinkLifespanSeconds": 900
  },
  "Outbox": {
    "IntervalInSeconds": 10,
    "BatchSize": 10,
    "MaxRetries": 2
  },
  "BackgroundJobs": {
    "Enabled": true,
    "CompleteExpiredBookings": {
      "CronExpression": "0 2 * * *"
    }
  }
}